      "lessonSlides": [
        {
          "id": "dqm-slide-1",
          "title": "`ma` makes yes-no questions",
          "description": "Use `ma` when the answer can be yes or no. Keep the rest of the sentence familiar.",
          "focusPoints": [
            "`ma doonaysaa?` asks `do you want?`",
            "`ma ... tahay?` asks `are you?`",
            "Food and drink phrases are good practice"
          ],
          "rows": [
            {
              "id": "dqm-lesson-1",
              "label": "ma",
              "prompt": "Do you want tea?",
              "answers": [
