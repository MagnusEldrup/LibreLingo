  "challenges": [
    {
      "type": "grammarTable",
      "id": "pt-1",
      "priority": 1,
      "group": "present-tense-tag",
      "instruction": "Learn the Somali present-tense markers for `tag-`, then answer mixed prompts one at a time.",
      "tableTitle": "Present tense of `tag-`",
      "columnHeaders": {
        "label": "Person",
        "prompt": "English cue",
        "answer": "Somali form"
      },
      "rows": [
        {
          "id": "pt-lesson-s-1",
          "label": "I",
          "prompt": "I am going.",
          "answers": [
            "Waan tagayaa."
          ]
        },
        {
          "id": "pt-lesson-s-2",
          "label": "You",
          "prompt": "You are going.",
          "answers": [
            "Waad tagaysaa."
          ]
        },
        {
          "id": "pt-lesson-s-3",
          "label": "He",
          "prompt": "He is going.",
          "answers": [
            "Wuu tagayaa."
          ]
        },
        {
          "id": "pt-lesson-s-4",
          "label": "She",
          "prompt": "She is going.",
          "answers": [
            "Way tagaysaa."
          ]
        },
        {
          "id": "pt-lesson-p-1",
          "label": "We (including you)",
          "prompt": "We are going, including you.",
          "answers": [
            "Waynu tagaynaa.",
            "Waynu tagayna."
          ]
        },
        {
          "id": "pt-lesson-p-2",
          "label": "We (not including you)",
          "prompt": "We are going, not including you.",
          "answers": [
            "Waannu tagaynaa.",
            "Waannu tagayna."
          ]
        },
        {
          "id": "pt-lesson-p-3",
          "label": "You all",
          "prompt": "You all are going.",
          "answers": [
            "Waydin tagaysaan."
          ]
        },
        {
          "id": "pt-lesson-p-4",
          "label": "They",
          "prompt": "They are going.",
          "answers": [
            "Way tagayaan."
          ]
        }
      ],
      "lessonSlides": [
        {
          "id": "pt-slide-1",
          "title": "Start with the singular markers",
          "description": "In the affirmative present tense, Somali puts a short subject marker before the verb. Read these examples aloud and notice which marker goes with each person.",
          "focusPoints": [
            "Use `waan` with `I`",
            "Use `waad` with `you`",
            "Use `wuu` with `he`",
            "Use `way` with `she` and often with `they`"
          ],
          "rows": [
            {
              "id": "pt-lesson-s-1",
              "label": "I",
              "prompt": "I am going.",
              "answers": [
                "Waan tagayaa."
              ]
            },
            {
              "id": "pt-lesson-s-2",
              "label": "You",
              "prompt": "You are going.",
              "answers": [
                "Waad tagaysaa."
              ]
            },
            {
              "id": "pt-lesson-s-3",
              "label": "He",
              "prompt": "He is going.",
              "answers": [
                "Wuu tagayaa."
              ]
            },
            {
              "id": "pt-lesson-s-4",
              "label": "She",
              "prompt": "She is going.",
              "answers": [
                "Way tagaysaa."
              ]
            }
          ]
        },
        {
          "id": "pt-slide-2",
          "title": "Plural forms add one important split",
          "description": "The plural forms follow the same idea, but Somali distinguishes between inclusive and exclusive `we`. Learn that contrast before you practise.",
          "focusPoints": [
            "`waynu` includes the person you are speaking to",
            "`waannu` excludes the person you are speaking to",
            "Use `waydin` for `you all`"
          ],
          "rows": [
            {
              "id": "pt-lesson-p-1",
              "label": "We (including you)",
              "prompt": "We are going, including you.",
              "answers": [
                "Waynu tagaynaa.",
                "Waynu tagayna."
              ]
            },
            {
              "id": "pt-lesson-p-2",
              "label": "We (not including you)",
              "prompt": "We are going, not including you.",
              "answers": [
                "Waannu tagaynaa.",
                "Waannu tagayna."
              ]
            },
            {
              "id": "pt-lesson-p-3",
              "label": "You all",
              "prompt": "You all are going.",
              "answers": [
                "Waydin tagaysaan."
              ]
            },
            {
              "id": "pt-lesson-p-4",
              "label": "They",
              "prompt": "They are going.",
              "answers": [
                "Way tagayaan."
              ]
            }
          ]
        },
        {
          "id": "pt-slide-3",
          "title": "Look for the pattern, not the sentence",
          "description": "Now focus on the pattern rather than memorizing a whole table. In practice, you will answer mixed prompts one by one.",
          "focusPoints": [
            "Start with the subject marker",
            "Then add the present-tense verb form",
            "Keep the same pattern even when the cue words change"
          ]
        }
      ],
      "practiceRows": [
        {
          "id": "pt-practice-1",
          "label": "I",
          "prompt": "I am going to greet Amina today.",
          "rule": "Use `waan` with a first-person present-tense action from the greetings context.",
          "answers": [
            "Waan salaamayaa Amina maanta."
          ]
        },
        {
          "id": "pt-practice-2",
          "label": "You",
          "prompt": "You are going home after saying goodbye.",
          "rule": "Use `waad` for `you`, then keep the sentence in the leave-taking context.",
          "answers": [
            "Waad tagaysaa guriga."
          ]
        },
        {
          "id": "pt-practice-3",
          "label": "He",
          "prompt": "He is asking about the family.",
          "rule": "Use `wuu` with a family check-in action from the early conversation lessons.",
          "answers": [
            "Wuu weydiinayaa qoyska."
          ]
        },
        {
          "id": "pt-practice-4",
          "label": "She",
          "prompt": "She is coming from London.",
          "rule": "Use `way` for `she` with the introduction phrase.",
          "answers": [
            "Way ka imanaysaa Landhan."
          ]
        },
        {
          "id": "pt-practice-5",
          "label": "We (including you)",
          "prompt": "We are greeting Khadija together, including you.",
          "rule": "Use `waynu` when `we` includes the person you are speaking to.",
          "answers": [
            "Waynu wada salaamaynaa Khadija.",
            "Waynu wada salaamaynaynaa Khadija."
          ]
        },
        {
          "id": "pt-practice-6",
          "label": "We (not including you)",
          "prompt": "We are welcoming the guest together, not including you.",
          "rule": "Use `waannu` when `we` does not include the person you are speaking to.",
          "answers": [
            "Waannu wada soo dhowaynaynaa martida.",
            "Waannu wada soo dhoweynaynaa martida."
          ]
        },
        {
          "id": "pt-practice-7",
          "label": "You all",
          "prompt": "You all are asking names.",
          "rule": "Use `waydin` for `you all` with a names/introduction action.",
          "answers": [
            "Waydin weydiinaysaan magacyada."
          ]
        },
        {
          "id": "pt-practice-8",
          "label": "They",
          "prompt": "They are saying goodbye tomorrow.",
          "rule": "Use `way` for `they` with a leave-taking phrase.",
          "answers": [
            "Way nabad gelyeynayaan berri.",
            "Way nabad gelyaynayaan berri."
          ]
        }
      ]
    }
  ]
}
